/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bulk",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-28",
	"build": {
		"command": "bun run build-client.ts",
	},
	"assets": {
		"directory": "./public",
	},
	"observability": {
		"enabled": true,
	},
	/**
	 * KV Namespace — CDN size cache + version resolution for @latest tags
	 * Run: wrangler kv namespace create CACHE
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#kv-namespaces
	 */
	"kv_namespaces": [
		{
			"binding": "CACHE",
			// TODO: replace with real ID from: wrangler kv namespace create CACHE
			"id": "00000000000000000000000000000000",
		},
	],
}
