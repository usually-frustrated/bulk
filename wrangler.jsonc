/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bulk",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-28",
	"build": {
		"command": "bun run build-client.ts",
	},
	"assets": {
		"directory": "./public",
	},
	"observability": {
		"enabled": true,
	},
	/**
	 * D1 Database — all persistent state: cdn_sizes, package_exports,
	 * package_versions, version_resolution.
	 *
	 * Setup:
	 *   wrangler d1 create bulk-bundle
	 *   # paste the database_id below
	 *   wrangler d1 migrations apply bulk-bundle --remote
	 *
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#d1-databases
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bulk-bundle",
			"database_id": "b60264ce-f58a-4a80-a208-c71ffde9ebb4",
			"migrations_dir": "./migrations",
		},
	],
}
